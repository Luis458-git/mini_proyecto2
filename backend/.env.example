# =============================================================================
# TicoTech HR Portal — Configuración de Variables de Entorno (Plantilla de Ejemplo)
# =============================================================================

# Configuración del Servidor Express
PORT=3000
NODE_ENV=development
TZ=America/Costa_Rica

# Base de Datos Relacional MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_clave_de_mysql_aqui
DB_NAME=rrhh_ticotech
DB_CONNECTION_LIMIT=10

# API de DeepSeek (compatible con el SDK de OpenAI)
DEEPSEEK_API_KEY=tu_api_key_de_deepseek_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Almacenamiento Vectorial (ChromaDB)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=politicas_rrhh_ticotech

# Integración con Google Cloud Console y Google Drive API v3
# Ruta al archivo de Cuenta de Servicio descargado de Google Cloud (debe estar fuera de Git)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# ID de la carpeta compartida en Google Drive donde residen los 10 documentos oficiales
GOOGLE_DRIVE_FOLDER_ID=tu_folder_id_de_google_drive
